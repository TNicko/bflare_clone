ENVIRONMENT=local
POSTGRES_DSN=postgresql://user:pass@host:5432/dbname

# SigLIP2 image embedding HTTP service (no trailing slash).
# Alpha / Hetzner embedder over Tailscale (same URL as the API):
IMAGE_EMBEDDING_SERVICE_URL=http://harvest-image-embedding:11435
# If MagicDNS fails from this host, use the Tailscale IP instead:
# IMAGE_EMBEDDING_SERVICE_URL=http://100.x.y.z:11435
# IMAGE_EMBEDDING_MODEL=siglip          # or mobilenet / slugs
# IMAGE_EMBEDDING_SERVICE_URL is SigLIP only. MobileNet uses:
# MOBILENET_EMBEDDING_SERVICE_URL=http://localhost:11436

# CPU SigLIP batches can be slow — keep timeout generous.
EMBEDDING_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO
TELEGRAM_FETCH_BEFORE=
TELEGRAM_FETCH_AFTER=

# --- Batch sizing (worker on Hetzner → embedder on Alpha 8 GB RAM) ---
# EMBED_BATCH_SIZE: images sent to /embed per request. This is what stresses
# the 8 GB SigLIP host (model ~2 GB + activations + decoded JPEGs).
#   4  = safest if you see OOM / 500s
#   8  = recommended sweet spot for CX33/Alpha 8 GB vision-only
#   12 = try if 8 is stable and you want more throughput
#   16+= often OOMs or thrash on 8 GB CPU; not worth it
EMBED_BATCH_SIZE=8

# DB_BATCH_SIZE: message rows pulled per page before embed+commit.
# Larger = fewer round-trips, coarser resume points. Worker-side only.
DB_BATCH_SIZE=100

# PEER_BATCH_SIZE: how many peers to claim per process start (then exit).
# Re-run (or --restart) to continue the queue. Does not affect embedder RAM.
PEER_BATCH_SIZE=500

# Default: only peers where download coverage has advanced past embed (no harvester).
EMBED_PENDING_ONLY=true

# Embedding store. "s3" (default) or "local".
EMBEDDING_STORE_BACKEND=s3
EMBEDDING_STORE_S3_BUCKET=messenger-harvest-embeddings
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# EMBEDDING_STORE_LOCAL_DIR=./.embstore
EMBEDDING_STORE_PREFIX=embeddings
EMBEDDING_MODALITY=image
# Vector dim follows the model (SigLIP 1152, MobileNet 1280).

# Optional peer filters:
# TELEGRAM_PEER_EXTERNAL_ID=-1002118777780
# TELEGRAM_PEER_NAME_QUERY=
# TELEGRAM_COMMUNITY_ID=
# TELEGRAM_CATEGORY_SLUGS=

# IMAGE_EMBED_IGNORE_CURSOR=1  # reprocess ignoring cursor / image_embedding_id skip
