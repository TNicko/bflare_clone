ENVIRONMENT=local
LOG_LEVEL=INFO

# Source of truth. SELECT-only on telegram_messages; DELETEs only its own search_outbox rows.
POSTGRES_DSN=postgresql://user:pass@host:5432/dbname

# Keyword index sink is Quickwit.
# Quickwit (infra/quickwit). Prod Tailscale: http://harvest-quickwit:7280
QUICKWIT_URL=http://localhost:7280

# Outbox rows claimed + applied per transaction.
INDEXER_BATCH_SIZE=500
# Seconds to sleep when the queue is empty (loop mode).
INDEXER_POLL_INTERVAL_SECONDS=2
# Refresh the index after each batch so changes are searchable immediately (dev convenience).
# Quickwit: ingest commit=force. Prod: set false.
INDEXER_REFRESH_AFTER_BATCH=true
