ENVIRONMENT=local
POSTGRES_DSN=postgresql://user:pass@host:5432/dbname

# Local Ollama (default):
# EMBEDDING_SERVICE_URL=http://localhost:11434
#
# RunPod GPU Ollama (HTTP proxy for port 11434) — no trailing slash:
# EMBEDDING_SERVICE_URL=https://xxxxx-11434.proxy.runpod.net
EMBEDDING_SERVICE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# Seconds for each /api/embed HTTP call. Use 300–600 on RunPod with large batches.
EMBEDDING_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO
TELEGRAM_FETCH_BEFORE=
TELEGRAM_FETCH_AFTER=
DB_BATCH_SIZE=250
# Local CPU: 8–32. RunPod A40 / big GPU: try 128–256 (raise if stable).
EMBED_BATCH_SIZE=32

# Embedding store. "s3" (default) or "local".
EMBEDDING_STORE_BACKEND=s3

# S3_BUCKET or EMBEDDING_STORE_S3_BUCKET
EMBEDDING_STORE_S3_BUCKET=messenger-harvest-embeddings
# S3_BUCKET=messenger-harvest-embeddings
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# EMBEDDING_STORE_LOCAL_DIR=./.embstore
EMBEDDING_STORE_PREFIX=embeddings
EMBEDDING_MODALITY=text
EMBEDDING_VECTOR_DIM=1024

# Optional peer filters (same pattern as fetch_messages):
# TELEGRAM_PEER_EXTERNAL_ID=-1002118777780
# TELEGRAM_PEER_NAME_QUERY=
# TELEGRAM_COMMUNITY_ID=
# TELEGRAM_CATEGORY_SLUGS=
