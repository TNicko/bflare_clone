POSTGRES_DSN=postgresql://...

# S3 (default harvest bucket + prefix). Terraform: MESSAGE_ARCHIVE_PREFIX=s3://messenger-harvest/messages/telegram
MESSAGE_ARCHIVE_BUCKET=messenger-harvest
MESSAGE_ARCHIVE_PREFIX=messages/telegram
# Or full URI (bucket + prefix parsed):
# MESSAGE_ARCHIVE_PREFIX=s3://messenger-harvest/messages/telegram
AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Local backend for tests / offline:
# MESSAGE_ARCHIVE_BACKEND=local
# MESSAGE_ARCHIVE_LOCAL_DIR=./.msgstore

# Hot = current calendar month + previous N months (partition-aligned).
MESSAGE_ARCHIVE_HOT_MONTHS=3
MESSAGE_ARCHIVE_BATCH_SIZE=5000
MESSAGE_ARCHIVE_ROWS_PER_PART=100000
MESSAGE_ARCHIVE_CHECKPOINT_DIR=.archive_messages_checkpoints
# MESSAGE_ARCHIVE_DRY_RUN=1
