# Env for the Alloy agent on each workload host (Hetzner work box + every Pi).
# Copy to deploy/observability/agent/.env (do not commit .env).

# Stable name in Grafana (use the same slug as WORKER_ID, e.g. pi-01 / hetzner-1).
AGENT_HOSTNAME=pi-01

# Loki on the observability host — Tailscale IP or MagicDNS name.
# Obs host must bind Loki beyond 127.0.0.1 (LOKI_HOST_BIND on that box).
#
# Examples:
#   LOKI_PUSH_URL=http://100.x.y.z:3100/loki/api/v1/push
#   LOKI_PUSH_URL=http://harvest-obs.tailnet-name.ts.net:3100/loki/api/v1/push
LOKI_PUSH_URL=http://REPLACE_WITH_OBS_TAILSCALE:3100/loki/api/v1/push

# Prometheus remote_write on the same obs host (needs PROMETHEUS_HOST_BIND there).
# Examples:
#   PROMETHEUS_REMOTE_WRITE_URL=http://100.x.y.z:9090/api/v1/write
PROMETHEUS_REMOTE_WRITE_URL=http://REPLACE_WITH_OBS_TAILSCALE:9090/api/v1/write
