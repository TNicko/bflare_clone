    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "CPU cores used \u00f7 host cores (machine_cpu_cores). 100% = all host CPUs busy by that container. Legend uses image short name (Docker 29 often sets name=container-id).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "axisLabel": "% of host CPU",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "title": "Container CPU (% of host)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (label_replace(rate(container_cpu_usage_seconds_total{image!=\"\"}[5m]), \"container\", \"$1\", \"image\", \"(?:.*/)?([^/:]+):.*\")) / scalar(machine_cpu_cores)",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Working set \u00f7 host RAM (machine_memory_bytes). 100% = that container alone would fill the host. Legend uses image short name (Docker 29 often sets name=container-id).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "percentunit",
