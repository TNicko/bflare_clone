# Central env for all fleet job tasks + the jobs agent.
# Copy to backend/jobs/.env on each host (Pi / Hetzner).
#
#   cp backend/jobs/.example.env backend/jobs/.env
#   # edit WORKER_ID + secrets
#   python -m jobs.agent --loop
#
# Docker:
#   docker compose -f deploy/docker-compose.jobs-agent.prod.yml up -d --build

ENVIRONMENT=production
LOG_LEVEL=INFO

POSTGRES_DSN=postgresql://user:pass@host:5432/harvest

# --- This host (required for the agent) ---
WORKER_ID=hetzner-1
WORKER_LABEL=Hetzner primary
# Empty WORKER_CAPABILITIES = all task types.
# WORKER_CAPABILITIES=fetch_messages,embed_messages,embed_images
# Seed max concurrency into DB on first register (and when WORKER_SEED_MAX_CONCURRENT=1).
# Afterwards change max_concurrent_jobs in SQL — DB wins.
WORKER_MAX_CONCURRENT_JOBS=2
WORKER_SEED_MAX_CONCURRENT=0
# WORKER_HOSTNAME=
# WORKER_TAILSCALE_IP=
# WORKER_GIT_SHA=
WORKER_POLL_IDLE_SECONDS=3
WORKER_HEARTBEAT_SECONDS=15
WORKER_LEASE_SECONDS=120

# --- Telegram (Telethon tasks) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_SESSION_LOCATION_ID=hetzner-1
# TELEGRAM_SERVER_ID=
# HARVESTER_EXTERNAL_ID=
TELEGRAM_DELAY_SECONDS=1.5
DB_BATCH_SIZE=200
# TELEGRAM_FETCH_AFTER=
# TELEGRAM_FETCH_BEFORE=

# --- Object storage ---
HARVEST_S3_BUCKET=messenger-harvest
S3_BUCKET=messenger-harvest
AWS_REGION=eu-west-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=

# --- Embeddings (optional per host) ---
# EMBEDDING_SERVICE_URL=http://localhost:11434
# EMBEDDING_MODEL=bge-m3
# IMAGE_EMBEDDING_SERVICE_URL=http://harvest-image-embedding:11435
# EMBEDDING_TIMEOUT_SECONDS=300
# EMBED_BATCH_SIZE=8
# PEER_BATCH_SIZE=500
# EMBEDDING_STORE_BACKEND=s3
# EMBEDDING_STORE_S3_BUCKET=messenger-harvest-embeddings
# EMBEDDING_STORE_PREFIX=embeddings

# --- Task-specific knobs (optional) ---
