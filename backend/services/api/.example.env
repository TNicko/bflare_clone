# Platform auth (Supabase JWT verification via JWKS).
# Local / non-prod: point at the Supabase **dev** project (same one the client uses).
# Auth emails (password reset, etc.) use that project's SMTP — Postmark **dev** server.
SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
PLATFORM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ENVIRONMENT=local
POSTGRES_DSN='postgresql://postgres.[DB_ID]:[DB_PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres'

LOG_LEVEL=INFO
EMBEDDING_SERVICE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# Keyword search backend: "pg" (ILIKE) or "quickwit".
SEARCH_KEYWORD_BACKEND=quickwit
# Quickwit (infra/quickwit). Prod Tailscale: http://harvest-quickwit:7280
QUICKWIT_URL=http://localhost:7280
# Search HTTP timeout (seconds). Default 60 — short values 502 under concurrency.
# QUICKWIT_TIMEOUT_SECS=60
# Cold message Parquet archive (writers: jobs/archive_messages; hydrate: msgstore):
# MESSAGE_ARCHIVE_PREFIX=s3://messenger-harvest/messages/telegram
# MESSAGE_ARCHIVE_BUCKET=messenger-harvest
# MESSAGE_ARCHIVE_HOT_MONTHS=3
# API needs AWS read on messages/telegram/* for hydrate after strip (3c).


# Semantic and reverse-image search use S3 Vectors.
# pHash near-dup search uses Postgres Hamming on telegram_image_blobs.
SEARCH_SEMANTIC_BACKEND=s3vectors
SEARCH_IMAGE_BACKEND=s3vectors
# See infra/s3-vectors. These match the code defaults.
S3_VECTORS_BUCKET=blackflare-message-vectors
S3_VECTORS_INDEX=messages-bge-m3-v1
S3_VECTORS_IMAGES_INDEX=images-siglip2-v1

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_ENCRYPTION_KEY=
TELEGRAM_SESSION_LOCATION_ID=local
TELEGRAM_SERVER_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
HARVEST_S3_BUCKET=messenger-harvest
EMBEDDING_STORE_S3_BUCKET=messenger-harvest-embeddings
EMBEDDING_STORE_PREFIX=embeddings
# SigLIP2 image embedding (reverse image search; vectors come from embed_images).
# Prod / shared (Hetzner + Tailscale MagicDNS):
IMAGE_EMBEDDING_SERVICE_URL=http://harvest-image-embedding:11435
# If Docker Desktop cannot resolve MagicDNS, use the Tailscale IP instead:
#   tailscale ip -4 harvest-image-embedding
# IMAGE_EMBEDDING_SERVICE_URL=http://100.x.y.z:11435
# Optional local container (deploy/docker-compose.image-embedding.dev.yml):
# IMAGE_EMBEDDING_SERVICE_URL=http://image-embedding:11435
# Host uvicorn (local process, not Docker):
# IMAGE_EMBEDDING_SERVICE_URL=http://localhost:11435

# Stripe billing (Checkout + Customer Portal + webhooks + embedded Elements).
# Leave secret/webhook/price empty locally to keep checkout/portal disabled;
# GET /billing/me still works from overrides + free plan.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
# One-time credit packs (Checkout mode=payment). Empty hides that pack.
STRIPE_SUCCESS_URL=http://localhost:5173/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:5173/billing?checkout=canceled
STRIPE_PORTAL_RETURN_URL=http://localhost:5173/billing

# Same PostHog project token as the client (VITE_POSTHOG_PROJECT_TOKEN).
# Empty disables server capture of api_search events.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# Usage emails (80% allowance, allowance used up, prepaid empty). Empty skips send.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM=
# POSTMARK_MESSAGE_STREAM=outbound
