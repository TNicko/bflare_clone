# Copied to .env on the host (do not commit .env).
# Used by docker compose variable substitution for Grafana.

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# When serving via Tailscale HTTPS, set to the URL you open in the browser, e.g.:
# GF_SERVER_ROOT_URL=https://harvest-api.tailnet-name.ts.net/
# GF_SERVER_ROOT_URL=http://127.0.0.1:3000

# Loki host bind. Leave 127.0.0.1 unless remote Alloy agents (other Hetzner box / Pis)
# need to push logs here over Tailscale — then use this host's Tailscale IP:
#   LOKI_HOST_BIND=100.x.y.z
# Do not use 0.0.0.0 on a public interface without firewall/ACL lockdown.
# LOKI_HOST_BIND=127.0.0.1

# Prometheus host bind (remote_write from Pi / workload Alloy agents).
# Same Tailscale IP as Loki when multi-host:
#   PROMETHEUS_HOST_BIND=100.x.y.z
# PROMETHEUS_HOST_BIND=127.0.0.1
