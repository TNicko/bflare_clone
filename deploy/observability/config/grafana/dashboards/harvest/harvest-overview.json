          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (container) (label_replace(container_memory_working_set_bytes{image!=\"\"}, \"container\", \"$1\", \"image\", \"(?:.*/)?([^/:]+):.*\")) / scalar(machine_memory_bytes)",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": {
